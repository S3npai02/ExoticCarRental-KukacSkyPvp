<Window x:Class="ExoticAdmin.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bérlés Szerkesztése" Height="550" Width="450"
        Background="#141414" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Tahoma, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentGold" Color="#D4A325"/>
        <SolidColorBrush x:Key="InputBg" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="BorderDark" Color="#333333"/>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,15,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#555555"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="BÉRLÉS KEZELÉSE" Foreground="{StaticResource AccentGold}" FontSize="26" FontWeight="Bold" Margin="0,0,0,25"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
            <StackPanel>

                <TextBlock Text="Ügyfél neve"/>
                <ComboBox x:Name="cmbCustomer" DisplayMemberPath="Name" SelectedValuePath="Id" Height="40" Padding="10,0" FontSize="14" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                <TextBlock Text="Kibérelt Autó"/>
                <ComboBox x:Name="cmbVehicle" DisplayMemberPath="Name" SelectedValuePath="Id" Height="40" Padding="10,0" FontSize="14" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                <TextBlock Text="Kezdés dátuma (ÉÉÉÉ-HH-NN)"/>
                <TextBox x:Name="txtStart"/>

                <TextBlock Text="Befejezés dátuma (ÉÉÉÉ-HH-NN)"/>
                <TextBox x:Name="txtEnd"/>

                <TextBlock Text="Végösszeg (Ft)"/>
                <TextBox x:Name="txtPrice"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
            <Button Content="Mégse" Style="{StaticResource FlatButtonStyle}" Width="90" Padding="12" Background="Transparent" Foreground="White" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,15,0" Click="BtnCancel_Click" Cursor="Hand"/>
            <Button Content="Mentés" Style="{StaticResource FlatButtonStyle}" Width="120" Padding="12" Background="{StaticResource AccentGold}" Foreground="#141414" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>