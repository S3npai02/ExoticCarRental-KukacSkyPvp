<Window x:Class="ExoticAdmin.VehicleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jármű Részletes Adatai" Height="780" Width="700"
        Background="#141414" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Tahoma, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentGold" Color="#D4A325"/>
        <SolidColorBrush x:Key="InputBg" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="BorderDark" Color="#333333"/>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#555555"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="JÁRMŰ KEZELÉSE" Foreground="{StaticResource AccentGold}" FontSize="26" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
            <StackPanel>

                <TextBlock Text="Alapadatok &amp; Megjelenés" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,10,0,15"/>
                <WrapPanel>
                    <StackPanel Width="300" Margin="0,0,20,0">
                        <TextBlock Text="Márka"/>
                        <TextBox x:Name="txtBrand"/>
                        <TextBlock Text="Modell"/>
                        <TextBox x:Name="txtModel"/>
                        <TextBlock Text="Kategória (pl. Sedan, SUV)"/>
                        <TextBox x:Name="txtCategory"/>
                        <TextBlock Text="Évjárat"/>
                        <TextBox x:Name="txtYear"/>
                        <TextBlock Text="Napi ár (Ft)"/>
                        <TextBox x:Name="txtPrice"/>
                    </StackPanel>
                    <StackPanel Width="300">
                        <TextBlock Text="Külső szín"/>
                        <TextBox x:Name="txtColor"/>
                        <TextBlock Text="Belső tér (Interior)"/>
                        <TextBox x:Name="txtInterior"/>
                        <TextBlock Text="Ajtók száma"/>
                        <TextBox x:Name="txtDoors"/>
                        <TextBlock Text="Súly (kg)"/>
                        <TextBox x:Name="txtWeight"/>
                        <TextBlock Text="Felni stílus"/>
                        <TextBox x:Name="txtWheel"/>
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="Elsődleges kép URL (URL link)"/>
                <TextBox x:Name="txtImageUrl" Margin="0,0,0,25"/>

                <TextBlock Text="Teljesítmény &amp; Hajtáslánc" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,15,0,15"/>
                <WrapPanel>
                    <StackPanel Width="300" Margin="0,0,20,0">
                        <TextBlock Text="Motor / Powertrain"/>
                        <TextBox x:Name="txtPowertrain"/>
                        <TextBlock Text="Váltó"/>
                        <TextBox x:Name="txtTransmission"/>
                        <TextBlock Text="Meghajtás (Drive)"/>
                        <TextBox x:Name="txtDrive"/>
                    </StackPanel>
                    <StackPanel Width="300">
                        <TextBlock Text="Lóerő (HP)"/>
                        <TextBox x:Name="txtHp"/>
                        <TextBlock Text="Nyomaték (Nm)"/>
                        <TextBox x:Name="txtTorque"/>
                        <TextBlock Text="Gyorsulás 0-100 (pl. 3.5s)"/>
                        <TextBox x:Name="txtAcceleration"/>
                        <TextBlock Text="Végsebesség (km/h)"/>
                        <TextBox x:Name="txtTopSpeed"/>
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="🔧 Szerviz &amp; Karbantartás" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,25,0,15"/>
                <WrapPanel>
                    <StackPanel Width="300" Margin="0,0,20,0">
                        <TextBlock Text="Jelenlegi kilométeróra állás"/>
                        <TextBox x:Name="txtMileage"/>
                    </StackPanel>
                    <StackPanel Width="300">
                        <TextBlock Text="Műszaki vizsga lejárata (ÉÉÉÉ-HH-NN)"/>
                        <TextBox x:Name="txtMotExpiry"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="Karbantartási napló (Olajcsere, javítások stb.)"/>
                <TextBox x:Name="txtMaintenance" TextWrapping="Wrap" Height="80" AcceptsReturn="True" Margin="0,0,0,25" VerticalContentAlignment="Top"/>

                <StackPanel>
                    <TextBlock Text="Státusz (1=Elérhető, 2=Kiadva, 3=Szerviz)"/>
                    <TextBox x:Name="txtStatus"/>

                    <TextBlock Text="Extrák (vesszővel elválasztva)"/>
                    <TextBox x:Name="txtExtras" TextWrapping="Wrap" Height="60" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                    <TextBlock Text="Részletes leírás"/>
                    <TextBox x:Name="txtDescription" TextWrapping="Wrap" Height="100" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
            <Button Content="Mégse" Style="{StaticResource FlatButtonStyle}" Width="100" Padding="12" Background="Transparent" Foreground="White" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,15,0" Click="BtnCancel_Click" Cursor="Hand"/>
            <Button Content="Mentés" Style="{StaticResource FlatButtonStyle}" Width="150" Padding="12" Background="{StaticResource AccentGold}" Foreground="#141414" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>