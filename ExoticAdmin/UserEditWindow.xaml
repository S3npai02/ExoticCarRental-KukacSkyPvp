<Window x:Class="ExoticAdmin.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Felhasználó Részletes Adatai" Height="750" Width="480"
        Background="#141414" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Tahoma, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentGold" Color="#D4A325"/>
        <SolidColorBrush x:Key="InputBg" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="BorderDark" Color="#333333"/>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#555555"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="FELHASZNÁLÓ KEZELÉSE" Foreground="{StaticResource AccentGold}" FontSize="26" FontWeight="Bold" Margin="0,0,0,25"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
            <StackPanel>

                <TextBlock Text="Profilkép" Margin="0,10,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="5,0,0,5">
                    <Border Width="70" Height="70" CornerRadius="35" BorderBrush="{StaticResource AccentGold}" BorderThickness="2" Margin="0,5,25,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#D4A325" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <Grid>
                            <Ellipse Fill="#1C1C1C"/>
                            <Image x:Name="imgProfile" Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry RadiusX="33" RadiusY="33" Center="33,33"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                    <Button Content="Kép tallózása..." Style="{StaticResource FlatButtonStyle}" Width="130" Height="40" Background="Transparent" Foreground="White" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Click="BtnBrowseImage_Click" Cursor="Hand" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Felhasználónév (Kötelező)"/>
                <TextBox x:Name="txtUsername"/>

                <TextBlock Text="Teljes név"/>
                <TextBox x:Name="txtFullName"/>

                <TextBlock Text="Email cím (Kötelező)"/>
                <TextBox x:Name="txtEmail"/>

                <TextBlock Text="Telefonszám"/>
                <TextBox x:Name="txtPhone"/>

                <TextBlock Text="Születési dátum (ÉÉÉÉ-HH-NN)"/>
                <TextBox x:Name="txtDob"/>

                <TextBlock Text="Jogosultsági szint (DB Clearance: 1=Vendég, 2=User, 3=Admin)"/>
                <TextBox x:Name="txtClearance"/>

                <CheckBox x:Name="chkIsDriver" Content="🚗 Az illető SOFŐR? (Munkatárs)" Foreground="White" FontSize="14" Margin="0,15,0,5"/>

                <TextBlock Text="Jogosítvány száma (Felhasználó státuszhoz kötelező)"/>
                <TextBox x:Name="txtLicense"/>

                <TextBlock Text="Jogosítvány lejárata (ÉÉÉÉ-HH-NN)"/>
                <TextBox x:Name="txtLicenseExpiry"/>

                <Rectangle Height="1" Fill="{StaticResource BorderDark}" Margin="0,20,0,20"/>
                <TextBlock Text="🚨 Adminisztrátori Beállítások" Foreground="#FF4B4B" FontSize="18" FontWeight="Bold"/>

                <CheckBox x:Name="chkIsBanned" Content="🚫 FELHASZNÁLÓ TILTÁSA (Feketelista)" Foreground="#FF4B4B" FontSize="14" FontWeight="Bold" Margin="0,15,0,15"/>

                <TextBlock Text="Belső megjegyzés (Ügyfél nem látja)"/>
                <TextBox x:Name="txtAdminNotes" TextWrapping="Wrap" Height="60" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                <CheckBox x:Name="chkIsVerified" Content="Fiók hitelesítve (Verified)" Foreground="{StaticResource AccentGold}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,10"/>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,25,0,0">
            <Button Content="🔑 Új jelszó" Style="{StaticResource FlatButtonStyle}" Width="110" Padding="12" Background="Transparent" Foreground="White" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Click="BtnGeneratePassword_Click" Cursor="Hand" HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Mégse" Style="{StaticResource FlatButtonStyle}" Width="90" Padding="12" Background="Transparent" Foreground="White" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,15,0" Click="BtnCancel_Click" Cursor="Hand"/>
                <Button Content="Mentés" Style="{StaticResource FlatButtonStyle}" Width="120" Padding="12" Background="{StaticResource AccentGold}" Foreground="#141414" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>